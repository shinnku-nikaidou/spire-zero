[tr][th][/th][th]Возвышение 0[/th][th]Возвышение 10[/th][th]Кошмар[/th][/tr]
[tr][td]Латоносец[/td][td]100% (200/200)[/td][td]84% (168/200)[/td][td]35% (70/200)[/td][/tr]
[tr][td]Безмолвная[/td][td]99% (198/200)[/td][td]75,5% (151/200)[/td][td]14% (28/200)[/td][/tr]
[tr][td]Дефект[/td][td]99% (198/200)[/td][td]73% (146/200)[/td][td]22,1% (44/199)[/td][/tr]
[tr][td]Наследник[/td][td]99,5% (199/200)[/td][td]58% (116/200)[/td][td]12,5% (25/200)[/td][/tr]
[tr][td]Призывающая[/td][td]97,5% (195/200)[/td][td]52% (104/200)[/td][td]10,5% (21/200)[/td][/tr]
