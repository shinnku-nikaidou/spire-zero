[tr][th][/th][th]ผู้บรรลุ 0[/th][th]ผู้บรรลุ 10[/th][th]Dread[/th][/tr]
[tr][td]นักรบเกราะเหล็ก[/td][td]99.5% (199/200)[/td][td]87.5% (175/200)[/td][td]46.2% (92/199)[/td][/tr]
[tr][td]นักฆ่าแห่งความเงียบ[/td][td]99% (198/200)[/td][td]75.5% (151/200)[/td][td]25% (50/200)[/td][/tr]
[tr][td]นักเวทแปรพักตร์[/td][td]99.5% (199/200)[/td][td]80.5% (161/200)[/td][td]30.8% (61/198)[/td][/tr]
