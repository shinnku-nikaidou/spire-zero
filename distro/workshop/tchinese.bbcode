[tr][td]寂靜獵手[/td][td]99.5% (199/200)[/td][td]83% (166/200)[/td][td]25% (50/200)[/td][/tr]
[tr][td]故障機器人[/td][td]100% (200/200)[/td][td]84.5% (169/200)[/td][td]32.3% (64/198)[/td][/tr]
[tr][td]儲君[/td][td]99% (198/200)[/td][td]75% (150/200)[/td][td]20% (40/200)[/td][/tr]
[tr][td]縛亡者[/td][td]99% (198/200)[/td][td]69% (138/200)[/td][td]20% (40/200)[/td][/tr]
[tr][td]愚者[/td][td]96% (192/200)[/td][td]44% (88/200)[/td][td]8.5% (17/200)[/td][/tr]
[/table]
