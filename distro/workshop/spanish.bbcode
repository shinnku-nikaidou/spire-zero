[tr][td]La Silenciosa[/td][td]92 % (46/50)[/td][td]20,5 % (41/200)[/td][/tr]
[tr][td]El Defectuoso[/td][td]92 % (46/50)[/td][td]16,5 % (33/200)[/td][/tr]
