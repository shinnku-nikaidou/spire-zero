---
// The page title, with the page's floor above it: its place in the book's reading order, which is the sidebar's.
// The book's first page gets the title screen in the title's place.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import TitleScreen from './TitleScreen.astro';

type Entry = StarlightRouteData['sidebar'][number];
type Link = Extract<Entry, { type: 'link' }>;

const pages = (entries: Entry[]): Link[] =>
  entries.flatMap((entry) => (entry.type === 'link' ? [entry] : pages(entry.entries)));

const { sidebar, lang, id, locale } = Astro.locals.starlightRoute;
const all = pages(sidebar);
const floor = all.findIndex((page) => page.isCurrent) + 1;
const first = id === (locale ?? '');

const words: Record<string, (n: number, total: number) => [string, string]> = {
  'zh-CN': (n, total) => [`第 ${n} 层`, `共 ${total} 层`],
  'zh-TW': (n, total) => [`第 ${n} 層`, `共 ${total} 層`],
  en: (n, total) => [`Floor ${n}`, `of ${total}`],
};
const [here, outOf] = (words[lang] ?? words.en)(floor, all.length);
---

<div class:list={{ 'spire-first': first }}>
  {
    floor > 0 && (
      <p class="spire-floor">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 20h4v-4h4v-4h4V8h4" />
        </svg>
        <span>{here}</span>
        <span>{outOf}</span>
      </p>
    )
  }
  {first ? <TitleScreen /> : <Default />}
</div>
