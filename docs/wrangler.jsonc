// The site as static assets on Cloudflare Workers, in the "shinnku" account: `pnpm run deploy` builds dist/ and uploads it.
{
  "name": "sts2-docs",
  "account_id": "<cloudflare-account-id>",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
