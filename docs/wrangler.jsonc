// The site as static assets on Cloudflare Workers: `pnpm run deploy` builds dist/ and uploads it. The account comes
// from CLOUDFLARE_ACCOUNT_ID in the environment.
{
  "name": "sts2-docs",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
