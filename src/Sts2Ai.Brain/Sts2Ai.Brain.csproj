<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Decides. Sees the game only through Sts2Ai.Protocol: no game assembly may be reachable from here, directly or
    through another project (SimWorker's selftest checks the compiled references).
  -->
  <ItemGroup>
    <ProjectReference Include="../Sts2Ai.Protocol/Sts2Ai.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Namespaces follow folders; these are in scope in every file. -->
    <Using Include="Sts2Ai.Brain.Combat" />
    <Using Include="Sts2Ai.Brain.Macro" />
  </ItemGroup>
</Project>
