<Project Sdk="Microsoft.NET.Sdk">

  <!-- port: translates the decompiled game (C#) to the Rust of engine/crates/sts2ai-engine/src/gen. See engine/DESIGN.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>port</AssemblyName>
    <RootNamespace>Sts2Ai.Port</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

</Project>
