<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The game side of the protocol, shared by the sim worker and the mod: builds observations from the live game
    objects, lists legal actions, and starts an action through the same entry points as the UI.
    Waiting for the game to settle afterwards is host-specific (the sim pumps; the mod waits for frames).
  -->
  <Import Project="../GameReferences.props" />

  <ItemGroup>
    <ProjectReference Include="../Sts2Ai.Protocol/Sts2Ai.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every event option's key, and which variables each event text shows (event_texts.py writes it from the game's pack). -->
    <EmbeddedResource Include="EventTexts.json" LogicalName="EventTexts.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Namespaces follow folders; these are in scope in every file. -->
    <Using Include="Sts2Ai.GameBridge.Actions" />
  </ItemGroup>
</Project>
