<Project>
  <!--
    A program says which commit it was built from (reports and net files name it). A build
    with uncommitted changes under src/ is not that commit, so its revision gets a "-dirty" suffix.
  -->
  <Target Name="MarkUncommittedSource" AfterTargets="InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' != ''">
    <Exec Command="git status --porcelain -- ." WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_UncommittedSource" />
    </Exec>
    <PropertyGroup Condition="'$(_UncommittedSource)' != ''">
      <SourceRevisionId>$(SourceRevisionId)-dirty</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
