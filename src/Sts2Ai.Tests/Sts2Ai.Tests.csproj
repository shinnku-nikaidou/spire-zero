<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of the parts that run without the game: the brain's own logic, Harness's routing and evaluation, and
    the sim's command line. Whatever needs a booted game is checked by the sim itself (selftest, run -check).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sts2Ai.SimWorker/Sts2Ai.SimWorker.csproj" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
