<Project>
  <!--
    The brain as the Workshop item ships it (plan plans/2026-11-07-1333-steam-workshop-release.md): one folder per
    platform, made by distro/publish-brain.sh with -r RID. A profile, so the fleet's builds stay as they are.
    - Self-contained: players have no .NET.
    - A folder, not one file: Harmony patches through the JIT's own library (libclrjit), which a single file builds
      into the executable ("Could not locate clrjit library"). Its deps.json and runtimeconfig.json have none of a
      manifest's fields, so the game's mod scan skips them with an info line.
    - Not trimmed: the brain loads the player's sts2.dll at run time, which needs the whole framework.
    - Tiered compilation stays off (the project's setting); DOTNET_ReadyToRun=0 is set by whoever starts the brain.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <SelfContained>true</SelfContained>
    <!-- sts2.dll is compiled against as built for x64; on each platform the brain loads the player's own at run time. -->
    <NoWarn>$(NoWarn);CS8012</NoWarn>
  </PropertyGroup>
</Project>
