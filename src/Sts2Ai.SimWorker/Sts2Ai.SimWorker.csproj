<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the real sts2.dll in plain .NET, without the Godot engine: combats for benchmarks, tests, search and
    self-play. Hosts the brain in-process, or as a worker (serve) searches for a host elsewhere; the brain still sees
    only protocol types.
  -->
  <Import Project="../GameReferences.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      No tiered compilation: every method is compiled once, fully optimized.
      - Safety: with tiering, the runtime re-JITs hot methods in the background and a Harmony patch can silently
        drop off. Seen after a few thousand combats, when RunManager.WriteReplay ran unpatched.
      - Speed: Harmony's JIT hook makes every extra compile slow, so tiering was 2x slower on short runs.
      Launchers should also set DOTNET_ReadyToRun=0, which can't be set here: framework code is then JIT-compiled
      fully optimized too, about 20% more combats/s.
    -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sts2Ai.GameBridge/Sts2Ai.GameBridge.csproj" />
    <ProjectReference Include="../Sts2Ai.Brain/Sts2Ai.Brain.csproj" />
    <ProjectReference Include="../Sts2Ai.Harness/Sts2Ai.Harness.csproj" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.22" />
    <InternalsVisibleTo Include="Sts2Ai.Tests" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Sts2BinDir</_Parameter1>
      <_Parameter2>$(Sts2BinDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Reports name the commit the build came from (docs: evaluation §6). A build with uncommitted changes under src/
    is not that commit, so its revision gets a "-dirty" suffix.
  -->
  <Target Name="MarkUncommittedSource" AfterTargets="InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' != ''">
    <Exec Command="git status --porcelain -- ." WorkingDirectory="$(MSBuildThisFileDirectory).." ConsoleToMSBuild="true"
          StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_UncommittedSource" />
    </Exec>
    <PropertyGroup Condition="'$(_UncommittedSource)' != ''">
      <SourceRevisionId>$(SourceRevisionId)-dirty</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
